# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gold_loan_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gold_loan_db

# Security & JWT
JWT_SECRET=super_secret_jwt_key_replace_in_production_123456789
JWT_EXPIRES_IN=7d

# WhatsApp Cloud API (Meta Graph API)
WHATSAPP_API_ENABLED=true
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=gold_loan_secure_webhook_token_2026

# SMS Provider (Twilio or Fast2SMS / Msg91)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Business / Shop Info
SHOP_NAME="Swarna Laxmi Bankers & Jewellers"
SHOP_PHONE="+91 98765 43210"
SHOP_ADDRESS="123 Bazaar Main Road, Gold Market, Chennai - 600001"
DEFAULT_GOLD_22K_RATE=6850.00
DEFAULT_SILVER_RATE=92.00
